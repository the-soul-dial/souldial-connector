{
  "name": "souldial-connector",
  "version": "0.1.0",
  "description": "Connect a USB Soul Dial life counter to a web app over Web Serial: read and write life totals and counters, with two-way table sync.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./convoke": {
      "types": "./src/convoke.d.ts",
      "default": "./src/convoke.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/connector.test.mjs",
    "demo": "node demo/serve.mjs"
  },
  "keywords": [
    "soul-dial",
    "souldial",
    "life-counter",
    "mtg",
    "magic-the-gathering",
    "commander",
    "web-serial",
    "webserial",
    "serial",
    "usb"
  ],
  "author": "Soul Dial",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-soul-dial/souldial-connector.git"
  },
  "homepage": "https://github.com/the-soul-dial/souldial-connector#readme",
  "bugs": {
    "url": "https://github.com/the-soul-dial/souldial-connector/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
